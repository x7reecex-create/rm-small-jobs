<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>RM Small Jobs Admin</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
:root{
  --n:#061a2b;
  --o:#f46b20;
  --bg:#f5f2eb;
  --ink:#14222d;
  --muted:#687780;
  --line:#dce2e5
}

*{box-sizing:border-box}

body{
  margin:0;
  background:var(--bg);
  color:var(--ink);
  font:15px system-ui,-apple-system,sans-serif
}

button,input,textarea{
  font:inherit
}

header{
  background:var(--n);
  color:white;
  padding:15px 16px;
  position:sticky;
  top:0;
  z-index:5
}

.head{
  max-width:760px;
  margin:auto;
  display:flex;
  justify-content:space-between;
  align-items:center
}

.wrap{
  max-width:760px;
  margin:auto;
  padding:18px 16px 90px
}

h1{
  font-size:30px;
  margin:5px 0
}

h2{
  font-size:20px;
  margin:0 0 12px
}

.muted{
  color:var(--muted);
  font-size:12px
}

.card{
  background:white;
  border:1px solid var(--line);
  border-radius:15px;
  padding:15px;
  margin:12px 0
}

.grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px
}

.stat{
  background:white;
  border:1px solid var(--line);
  border-radius:13px;
  padding:14px
}

.stat b{
  display:block;
  font-size:24px;
  margin-top:3px
}

.btn{
  border:0;
  border-radius:10px;
  padding:10px 13px;
  font-weight:800
}

.primary{
  background:var(--o);
  color:#fff
}

.secondary{
  background:#fff;
  border:1px solid var(--line)
}

.danger{
  color:#b42318
}

.field{
  margin:9px 0
}

.field label{
  display:block;
  font-size:10px;
  font-weight:900;
  color:var(--muted)
}

.field input,
.field textarea{
  width:100%;
  margin-top:4px;
  padding:10px;
  border:1px solid var(--line);
  border-radius:9px;
  background:#fff
}

.row{
  display:flex;
  justify-content:space-between;
  gap:10px;
  border-top:1px solid var(--line);
  padding:12px 0
}

.row:first-child{
  border-top:0
}

.actions{
  display:flex;
  gap:8px;
  flex-wrap:wrap
}

.tabs{
  display:flex;
  gap:6px;
  overflow:auto;
  margin:0 0 15px
}

.tab{
  white-space:nowrap;
  border:1px solid var(--line);
  background:white;
  border-radius:99px;
  padding:8px 11px;
  font-size:11px;
  font-weight:800
}

.tab.on{
  background:var(--n);
  color:white
}

.nav{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  background:white;
  border-top:1px solid var(--line);
  display:grid;
  grid-template-columns:repeat(4,1fr);
  padding:5px;
  z-index:8
}

.nav button{
  border:0;
  background:white;
  padding:8px 2px;
  font-size:10px;
  font-weight:900;
  color:var(--muted);
  border-radius:10px
}

.nav .on{
  background:#fff0e8;
  color:var(--o)
}

.toast{
  position:fixed;
  bottom:78px;
  left:50%;
  transform:translateX(-50%);
  background:var(--n);
  color:white;
  padding:10px 14px;
  border-radius:10px;
  display:none;
  z-index:20;
  font-size:12px
}

.preview{
  background:var(--n);
  color:white;
  border-radius:13px;
  padding:16px
}

.preview .item{
  background:white;
  color:var(--ink);
  border-radius:9px;
  padding:10px;
  margin-top:7px
}

.price{
  color:var(--o);
  font-weight:900
}

@media(min-width:700px){

  .nav{
    position:static;
    max-width:760px;
    margin:auto;
    border:0
  }

  .wrap{
    padding-bottom:25px
  }
}
</style>
</head>

<body>

<div id="app"></div>

<div id="toast" class="toast"></div>

<script>

let sb=null;

let cfg=JSON.parse(
  localStorage.getItem('rm_sb')||'null'
);

let cms={};

const $=x=>document.getElementById(x);

function esc(x){
  return String(x??'').replace(
    /[&<>"']/g,
    c=>({
      '&':'&amp;',
      '<':'&lt;',
      '>':'&gt;',
      '"':'&quot;',
      "'":'&#39;'
    }[c])
  );
}

function say(x){

  $('toast').textContent=x;

  $('toast').style.display='block';

  setTimeout(
    ()=>$('toast').style.display='none',
    1800
  );
}

function setup(){

  app.innerHTML=`

  <main class="wrap">

    <div class="card">

      <h1>RM Small Jobs</h1>

      <p class="muted">
        One-time connection to your Supabase project.
      </p>

      <div class="field">

        <label>PROJECT URL</label>

        <input
          id="url"
          value="https://metaquqdynxwkplojlhwq.supabase.co"
        >

      </div>

      <div class="field">

        <label>ANON / PUBLISHABLE KEY</label>

        <textarea
          id="key"
          rows="4"
          placeholder="Paste the browser-safe key from Supabase"
        ></textarea>

      </div>

      <button
        class="btn primary"
        onclick="connect()"
      >
        Connect
      </button>

      <p class="muted">
        Never use a service-role or secret key here.
      </p>

    </div>

  </main>

  `;
}

function connect(){

  const url=$('url').value.trim();

  const key=$('key').value.trim();

  if(!url||!key){

    return say(
      'Both fields are required'
    );

  }

  cfg={
    url,
    key
  };

  localStorage.setItem(
    'rm_sb',
    JSON.stringify(cfg)
  );

  start();
}

function login(){

  app.innerHTML=`

  <main class="wrap">

    <div class="card">

      <h1>RM Small Jobs</h1>

      <p class="muted">
        Private admin login
      </p>

      <div class="field">

        <label>EMAIL</label>

        <input
          id="email"
          type="email"
        >

      </div>

      <div class="field">

        <label>PASSWORD</label>

        <input
          id="pass"
          type="password"
        >

      </div>

      <button
        class="btn primary"
        onclick="signin()"
      >
        Sign in
      </button>

    </div>

  </main>

  `;
}

async function signin(){

  let r=await sb.auth.signInWithPassword({

    email:$('email').value,

    password:$('pass').value

  });

  if(r.error){

    say(r.error.message);

  }else{

    start();

  }
}

async function start(){

  if(!cfg){

    setup();

    return;

  }

  sb=supabase.createClient(
    cfg.url,
    cfg.key
  );

  let r=await sb.auth.getSession();

  if(!r.data.session){

    login();

    return;

  }

  shell();

  home();
}

function shell(){

  app.innerHTML=`

  <header>

    <div class="head">

      <div>

        <b>RM Small Jobs</b>

        <div
          class="muted"
          style="color:#aabcc5"
        >
          Private control centre
        </div>

      </div>

      <button
        class="btn secondary"
        onclick="logout()"
      >
        Log out
      </button>

    </div>

  </header>

  <main
    id="main"
    class="wrap"
  ></main>

  <nav class="nav">

    <button
      class="on"
      onclick="go('home',this)"
    >
      ⌂<br>Home
    </button>

    <button
      onclick="go('website',this)"
    >
      ▣<br>Website
    </button>

    <button
      onclick="go('jobs',this)"
    >
      ✓<br>Jobs
    </button>

    <button
      onclick="go('money',this)"
    >
      £<br>Money
    </button>

  </nav>

  `;
}

function go(page,b){

  document
    .querySelectorAll('.nav button')
    .forEach(
      x=>x.classList.remove('on')
    );

  b.classList.add('on');

  ({
    home,
    website,
    jobs,
    money
  }[page])();
}

async function home(){

  let [
    j,
    c,
    e,
    s
  ]=await Promise.all([

    sb
      .from('jobs')
      .select('price,status'),

    sb
      .from('customers')
      .select('id'),

    sb
      .from('expenses')
      .select('amount'),

    sb
      .from('services')
      .select('id')
      .eq('enabled',true)

  ]);

  let jobs=j.data||[];

  let exp=e.data||[];

  main.innerHTML=`

    <h1>Overview</h1>

    <p class="muted">
      Your business at a glance.
    </p>

    <div class="grid">

      <div class="stat">
        Booked
        <b>
          ${jobs.filter(
            x=>x.status==='Booked'
          ).length}
        </b>
      </div>

      <div class="stat">
        Customers
        <b>
          ${(c.data||[]).length}
        </b>
      </div>

      <div class="stat">
        Live services
        <b>
          ${(s.data||[]).length}
        </b>
      </div>

      <div class="stat">
        Expenses
        <b>
          £${exp.reduce(
            (a,x)=>a+Number(x.amount||0),
            0
          ).toFixed(0)}
        </b>
      </div>

    </div>

    <div class="card">

      <h2>Quick actions</h2>

      <div class="actions">

        <button
          class="btn primary"
          onclick="goBy('website')"
        >
          Edit website
        </button>

        <button
          class="btn secondary"
          onclick="newJob()"
        >
          + New job
        </button>

        <button
          class="btn secondary"
          onclick="newCustomer()"
        >
          + Customer
        </button>

        <button
          class="btn secondary"
          onclick="newExpense()"
        >
          + Expense
        </button>

      </div>

    </div>

  `;
}

function goBy(p){

  let b=[...document
    .querySelectorAll('.nav button')]
    .find(
      x=>x.textContent
        .toLowerCase()
        .includes(p)
    );

  if(b)go(p,b);
}

async function website(){

  let [
    set,
    s,
    f,
    a,
    g
  ]=await Promise.all([

    sb
      .from('site_settings')
      .select('*')
      .limit(1)
      .maybeSingle(),

    sb
      .from('services')
      .select('*')
      .order('sort_order'),

    sb
      .from('faqs')
      .select('*')
      .order('sort_order'),

    sb
      .from('service_areas')
      .select('*')
      .order('sort_order'),

    sb
      .from('gallery')
      .select('*')
      .order(
        'created_at',
        {ascending:false}
      )

  ]);

  cms={
    set:set.data,
    s:s.data||[],
    f:f.data||[],
    a:a.data||[],
    g:g.data||[]
  };

  renderWebsite();
}

function renderWebsite(){

  let x=cms.set||{};

  main.innerHTML=`

    <h1>Website</h1>

    <p class="muted">
      Change customer-facing content
      without editing code.
    </p>

    <div class="tabs">

      <button
        class="tab on"
        onclick="wtab('home',this)"
      >
        Homepage
      </button>

      <button
        class="tab"
        onclick="wtab('services',this)"
      >
        Services
      </button>

      <button
        class="tab"
        onclick="wtab('faq',this)"
      >
        FAQs
      </button>

      <button
        class="tab"
        onclick="wtab('areas',this)"
      >
        Areas
      </button>

      <button
        class="tab"
        onclick="wtab('gallery',this)"
      >
        Gallery
      </button>

    </div>

    <div id="wp"></div>

  `;

  wtab(
    'home',
    document.querySelector('.tab.on')
  );
}

function wtab(type,b){

  document
    .querySelectorAll('.tab')
    .forEach(
      x=>x.classList.remove('on')
    );

  b.classList.add('on');

  let h='';

  if(type==='home'){

    let x=cms.set||{};

    h=`

    <div class="card">

      <h2>Homepage</h2>

      <div class="field">

        <label>HEADLINE</label>

        <input
          id="headline"
          value="${esc(
            x.headline||
            'Small jobs. Done properly.'
          )}"
        >

      </div>

      <div class="field">

        <label>INTRO</label>

        <textarea
          id="intro"
          rows="3"
        >${esc(x.intro||'')}</textarea>

      </div>

      <div class="field">

        <label>
          BOUNDARY / REASSURANCE
        </label>

        <textarea
          id="boundary"
          rows="3"
        >${esc(x.boundary||'')}</textarea>

      </div>

      <div class="field">

        <label>PHONE</label>

        <input
          id="phone"
          value="${esc(x.phone||'')}"
        >

      </div>

      <div class="field">

        <label>WHATSAPP</label>

        <input
          id="whatsapp"
          value="${esc(x.whatsapp||'')}"
        >

      </div>

      <button
        class="btn primary"
        onclick="saveHome()"
      >
        Save
      </button>

    </div>

    <div class="card">

      <h2>Preview</h2>

      <div class="preview">

        <b>LIVE PREVIEW</b>

        <h2>
          ${esc(
            x.headline||
            'Small jobs. Done properly.'
          )}
        </h2>

        <div>
          ${esc(x.intro||'')}
        </div>

      </div>

    </div>

    `;

  }

  else if(type==='services'){

    h=`

    <div class="card">

      <h2>Services & prices</h2>

      <button
        class="btn primary"
        onclick="addService()"
      >
        + Service
      </button>

      <div>

        ${cms.s.map((x,i)=>`

          <div class="row">

            <div style="flex:1">

              <div class="field">

                <label>NAME</label>

                <input
                  value="${esc(x.name)}"
                  oninput="
                    cms.s[${i}].name=this.value
                  "
                >

              </div>

              <div class="field">

                <label>PRICE</label>

                <input
                  value="${esc(x.price)}"
                  oninput="
                    cms.s[${i}].price=this.value
                  "
                >

              </div>

              <div class="field">

                <label>DESCRIPTION</label>

                <textarea
                  rows="2"
                  oninput="
                    cms.s[${i}].description=this.value
                  "
                >${esc(x.description)}</textarea>

              </div>

              <label class="muted">

                <input
                  type="checkbox"
                  ${x.enabled?'checked':''}
                  onchange="
                    cms.s[${i}].enabled=this.checked
                  "
                >

                Visible

              </label>

            </div>

            <button
              class="btn secondary danger"
              onclick="saveService(${i})"
            >
              Save
            </button>

          </div>

        `).join('')}

      </div>

    </div>

    `;

  }

  else if(type==='faq'){

    h=`

    <div class="card">

      <h2>FAQs</h2>

      <button
        class="btn primary"
        onclick="addFaq()"
      >
        + FAQ
      </button>

      ${cms.f.map((x,i)=>`

        <div class="row">

          <div style="flex:1">

            <div class="field">

              <label>QUESTION</label>

              <input
                value="${esc(x.question)}"
                oninput="
                  cms.f[${i}].question=this.value
                "
              >

            </div>

            <div class="field">

              <label>ANSWER</label>

              <textarea
                rows="2"
                oninput="
                  cms.f[${i}].answer=this.value
                "
              >${esc(x.answer)}</textarea>

            </div>

          </div>

          <button
            class="btn secondary danger"
            onclick="saveFaq(${i})"
          >
            Save
          </button>

        </div>

      `).join('')}

    </div>

    `;

  }

  else if(type==='areas'){

    h=`

    <div class="card">

      <h2>Areas</h2>

      <button
        class="btn primary"
        onclick="addArea()"
      >
        + Area
      </button>

      ${cms.a.map((x,i)=>`

        <div class="row">

          <input
            style="
              flex:1;
              padding:10px;
              border:1px solid var(--line);
              border-radius:9px
            "
            value="${esc(x.name)}"
            oninput="
              cms.a[${i}].name=this.value
            "
          >

          <button
            class="btn secondary"
            onclick="saveArea(${i})"
          >
            Save
          </button>

        </div>

      `).join('')}

    </div>

    `;

  }

  else{

    h=`

    <div class="card">

      <h2>Gallery</h2>

      <button
        class="btn primary"
        onclick="addGallery()"
      >
        + Photo
      </button>

      ${cms.g.map((x,i)=>`

        <div class="row">

          <div style="flex:1">

            <div class="field">

              <label>IMAGE URL</label>

              <input
                value="${esc(x.image_url)}"
                oninput="
                  cms.g[${i}].image_url=this.value
                "
              >

            </div>

            <div class="field">

              <label>TITLE</label>

              <input
                value="${esc(x.title)}"
                oninput="
                  cms.g[${i}].title=this.value
                "
              >

            </div>

            <label class="muted">

              <input
                type="checkbox"
                ${x.published?'checked':''}
                onchange="
                  cms.g[${i}].published=this.checked
                "
              >

              Public

            </label>

          </div>

          <button
            class="btn secondary"
            onclick="saveGallery(${i})"
          >
            Save
          </button>

        </div>

      `).join('')}

    </div>

    `;

  }

  wp.innerHTML=h;
}

async function saveHome(){

  let d={

    headline:headline.value,

    intro:intro.value,

    boundary:boundary.value,

    phone:phone.value,

    whatsapp:whatsapp.value,

    updated_at:new Date().toISOString()

  };

  let r=cms.set

    ?await sb
      .from('site_settings')
      .update(d)
      .eq('id',cms.set.id)

    :await sb
      .from('site_settings')
      .insert(d);

  if(r.error){

    say(r.error.message);

  }else{

    say('Saved');

    website();

  }
}

async function saveService(i){

  let x=cms.s[i];

  let r=await sb
    .from('services')
    .update({

      name:x.name,

      price:x.price,

      description:x.description,

      enabled:x.enabled,

      updated_at:new Date().toISOString()

    })
    .eq('id',x.id);

  if(r.error){

    say(r.error.message);

  }else{

    say('Service saved');

  }
}

async function addService(){

  let r=await sb
    .from('services')
    .insert({

      name:'New service',

      price:'Quote',

      description:'',

      enabled:true,

      featured:false,

      sort_order:cms.s.length

    });

  if(r.error){

    say(r.error.message);

  }else{

    website();

  }
}

async function saveFaq(i){

  let x=cms.f[i];

  let r=await sb
    .from('faqs')
    .update({

      question:x.question,

      answer:x.answer

    })
    .eq('id',x.id);

  if(r.error){

    say(r.error.message);

  }else{

    say('FAQ saved');

  }
}

async function addFaq(){

  let r=await sb
    .from('faqs')
    .insert({

      question:'New question',

      answer:'',

      sort_order:cms.f.length

    });

  if(r.error){

    say(r.error.message);

  }else{

    website();

  }
}

async function saveArea(i){

  let x=cms.a[i];

  let r=await sb
    .from('service_areas')
    .update({

      name:x.name

    })
    .eq('id',x.id);

  if(r.error){

    say(r.error.message);

  }else{

    say('Area saved');

  }
}

async function addArea(){

  let r=await sb
    .from('service_areas')
    .insert({

      name:'New area',

      sort_order:cms.a.length

    });

  if(r.error){

    say(r.error.message);

  }else{

    website();

  }
}

async function saveGallery(i){

  let x=cms.g[i];

  let r=await sb
    .from('gallery')
    .update({

      image_url:x.image_url,

      title:x.title,

      published:x.published

    })
    .eq('id',x.id);

  if(r.error){

    say(r.error.message);

  }else{

    say('Gallery saved');

  }
}

async function addGallery(){

  let r=await sb
    .from('gallery')
    .insert({

      image_url:'',

      title:'New gallery item',

      description:'',

      published:false

    });

  if(r.error){

    say(r.error.message);

  }else{

    website();

  }
}

async function jobs(){

  let r=await sb
    .from('jobs')
    .select('*')
    .order('scheduled_at');

  let d=r.data||[];

  main.innerHTML=`

    <h1>Jobs</h1>

    <button
      class="btn primary"
      onclick="newJob()"
    >
      + New job
    </button>

    <div class="card">

      ${
        d.map(x=>`

          <div class="row">

            <div>

              <b>
                ${esc(x.title)}
              </b>

              <div class="muted">

                ${esc(x.status)}
                ·
                £${Number(
                  x.price||0
                ).toFixed(2)}

              </div>

            </div>

            <div class="muted">

              ${
                x.scheduled_at
                  ?new Date(
                    x.scheduled_at
                  ).toLocaleDateString()
                  :'No date'
              }

            </div>

          </div>

        `).join('')

        ||

        '<p class="muted">No jobs yet.</p>'

      }

    </div>

  `;
}

async function money(){

  let [
    j,
    e
  ]=await Promise.all([

    sb
      .from('jobs')
      .select('price,status'),

    sb
      .from('expenses')
      .select('*')
      .order(
        'created_at',
        {ascending:false}
      )

  ]);

  let jobs=j.data||[];

  let ex=e.data||[];

  let rev=jobs
    .filter(
      x=>
        x.status==='Paid'||
        x.status==='Completed'
    )
    .reduce(
      (a,x)=>a+Number(x.price||0),
      0
    );

  let cost=ex.reduce(
    (a,x)=>a+Number(x.amount||0),
    0
  );

  main.innerHTML=`

    <h1>Money</h1>

    <div class="grid">

      <div class="stat">

        Revenue

        <b>
          £${rev.toFixed(0)}
        </b>

      </div>

      <div class="stat">

        Expenses

        <b>
          £${cost.toFixed(0)}
        </b>

      </div>

      <div class="stat">

        Profit

        <b>
          £${(
            rev-cost
          ).toFixed(0)}
        </b>

      </div>

      <div class="stat">

        Unpaid

        <b>

          £${
            jobs
              .filter(
                x=>
                  x.status!=='Paid'&&
                  x.status!=='Cancelled'
              )
              .reduce(
                (a,x)=>
                  a+Number(x.price||0),
                0
              )
              .toFixed(0)
          }

        </b>

      </div>

    </div>

    <div class="card">

      <button
        class="btn primary"
        onclick="newExpense()"
      >
        + Expense
      </button>

      ${
        ex.map(x=>`

          <div class="row">

            <span>
              ${esc(
                x.note||
                x.category
              )}
            </span>

            <b>
              £${Number(
                x.amount
              ).toFixed(2)}
            </b>

          </div>

        `).join('')
      }

    </div>

  `;
}

async function newJob(){

  let title=prompt(
    'Job name'
  );

  if(!title)return;

  let price=Number(
    prompt(
      'Price (£)',
      '0'
    )||0
  );

  let r=await sb
    .from('jobs')
    .insert({

      title,

      price,

      status:'Booked',

      payment_status:'Unpaid'

    });

  if(r.error){

    say(r.error.message);

  }else{

    say('Job added');

    jobs();

  }
}

async function newCustomer(){

  let name=prompt(
    'Customer name'
  );

  if(!name)return;

  let r=await sb
    .from('customers')
    .insert({
      name
    });

  say(
    r.error
      ?r.error.message
      :'Customer added'
  );
}

async function newExpense(){

  let amount=Number(
    prompt(
      'Expense (£)',
      '0'
    )||0
  );

  if(!amount)return;

  let note=prompt(
    'What was it for?'
  )||'';

  let r=await sb
    .from('expenses')
    .insert({

      amount,

      note,

      category:'Other'

    });

  if(r.error){

    say(r.error.message);

  }else{

    say('Expense saved');

    money();

  }
}

async function logout(){

  await sb.auth.signOut();

  login();
}

start();

</script>

